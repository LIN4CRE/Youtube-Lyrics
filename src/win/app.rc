// Windows resources: application icon, built-in wallpaper images, and version info.
#include <winver.h>
#include "resource.h"
#include "version.rcinc"

1 ICON "app.ico"
// Application manifest (RT_MANIFEST = 24): supported Windows versions,
// per-monitor DPI awareness and asInvoker.
1 24 "src/win/app.manifest"
IDR_WALLPAPER_CITY RCDATA "src/win/wallpapers/city-rain.jpg"
IDR_WALLPAPER_MOUNTAIN RCDATA "src/win/wallpapers/mountain-night.jpg"
IDR_WALLPAPER_FOREST RCDATA "src/win/wallpapers/forest-mist.jpg"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    YTL_FILE_VERSION
 PRODUCTVERSION YTL_FILE_VERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "LIN4CRE"
            VALUE "FileDescription",  "Cinematic lyrics desktop wallpaper for Windows"
            VALUE "FileVersion",      YTL_FILE_VERSION_STRING
            VALUE "InternalName",     "YoutubeLyrics"
            VALUE "OriginalFilename", "YoutubeLyrics.exe"
            VALUE "ProductName",      "Youtube-Lyrics"
            VALUE "ProductVersion",   YTL_FILE_VERSION_STRING
            VALUE "LegalCopyright",   "Copyright (c) 2026 LIN4CRE"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
