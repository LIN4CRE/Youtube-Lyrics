// Windows resources: application icon and version info.
#include <winver.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Youtube-Lyrics"
            VALUE "FileDescription",  "Desktop lyrics for the active Windows media session"
            VALUE "FileVersion",      "1.3.0.0"
            VALUE "InternalName",     "YoutubeLyrics"
            VALUE "OriginalFilename", "YoutubeLyrics.exe"
            VALUE "ProductName",      "Youtube-Lyrics"
            VALUE "ProductVersion",   "1.3.0.0"
            VALUE "LegalCopyright",   "Free and open source"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
